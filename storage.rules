rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null;
    }

    match /resources/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('application/.*pdf.*'));
    }
  }
}
